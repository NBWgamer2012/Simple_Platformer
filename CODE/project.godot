; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simple Platformer"
run/main_scene="uid://dnuys1nbw0hff"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

shared="*uid://crwoqe6f1yybo"
Savepositions="uid://wsjyxwc6nec6"
Collectiables="*uid://wlsld5dv8ua3"
Debug="*uid://die2r0n3s06dj"
tutorial="*uid://cq5r44bs4lvt"
AudioSystem="*uid://bcwu4i3s71qvu"
audioinfo="*uid://b81ueydotbd7l"

[copy_files_on_export]

files=Array[PackedStringArray]([PackedStringArray("res://assets/Audio", "assets/Audio", "")])

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/copy_files_on_export/plugin.cfg")

[global_group]

Player="This is the players collider"
hole=""

